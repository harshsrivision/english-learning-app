# Backend runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bolo_english
PORT=4000
API_PORT=4000
CLIENT_ORIGINS=http://localhost:3000

# Local API host (used for development)
API_ORIGIN=http://localhost:4000

# Public API URLs for the frontend (local)
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_ANALYZE_API_URL=http://localhost:4000/analyze
NEXT_PUBLIC_CORRECTION_API_URL=http://localhost:4000/correct
NEXT_PUBLIC_CONVERSATION_API_URL=http://localhost:4000/chat
NEXT_PUBLIC_DAILY_PROGRESS_API_URL=http://localhost:4000/daily-progress
NEXT_PUBLIC_LESSON_PROGRESS_API_URL=http://localhost:4000/lesson-progress
NEXT_PUBLIC_LESSONS_API_URL=http://localhost:4000/lessons
NEXT_PUBLIC_LOGIN_API_URL=http://localhost:4000/login
NEXT_PUBLIC_PRONUNCIATION_API_URL=http://localhost:4000/pronunciation
NEXT_PUBLIC_SIGNUP_API_URL=http://localhost:4000/signup
NEXT_PUBLIC_USER_API_URL=http://localhost:4000/user
NEXT_PUBLIC_VOCABULARY_API_URL=http://localhost:4000/vocabulary
NEXT_PUBLIC_VOCABULARY_PROGRESS_API_URL=http://localhost:4000/vocabulary-progress


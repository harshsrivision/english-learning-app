{
  "name": "english-learning-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev",
    "build:api": "npm --prefix server run build",
    "dev:api": "npm run build:api && node server/dist/index.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.12",
    "openai": "^6.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/sqlite3": "^3.1.11",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
